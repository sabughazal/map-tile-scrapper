HOST=0.0.0.0
PORT=8100

# Gunicorn/Uvicorn workers (Docker). Keep at 1: prefetch & GeoTIFF jobs hold state
# in memory per process, so multiple workers would split job start/status/cancel.
WEB_CONCURRENCY=1

# Host port published by docker compose (container always listens on 8000).
APP_PORT=8000

OUTPUT_DIR=./data
SOURCE_URL=https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}

# GeoTIFF export: concurrent downloads (leave commented for auto based on CPU count)
# GEOTIFF_MAX_WORKERS=8

# Auto tile prefetch: concurrent downloads (leave commented for auto based on CPU count)
# PREFETCH_MAX_WORKERS=8
